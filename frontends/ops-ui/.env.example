# VESPER Ops UI Environment Configuration

# API Gateway URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Grafana Configuration
GRAFANA_URL=http://localhost:3000
NEXT_PUBLIC_GRAFANA_URL=http://localhost:3000

# Cognito Configuration
NEXT_PUBLIC_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
NEXT_PUBLIC_COGNITO_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX
NEXT_PUBLIC_COGNITO_DOMAIN=vesper-dev.auth.us-east-1.amazoncognito.com
NEXT_PUBLIC_COGNITO_REGION=us-east-1

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=your-secret-key-here

# Auth Provider
AUTH_COGNITO_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX
AUTH_COGNITO_SECRET=your-cognito-secret
AUTH_COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_XXXXXXXXX

# MLflow Configuration
NEXT_PUBLIC_MLFLOW_URL=http://localhost:5000

# Airflow Configuration  
NEXT_PUBLIC_AIRFLOW_URL=http://localhost:8080

# S3 Configuration
EVAL_RESULTS_BUCKET=vesper-artifacts-dev
