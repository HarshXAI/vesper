# VESPER Ingestion Service Configuration

# Service Settings
SERVICE_NAME=vesper-ingestion
LOG_LEVEL=INFO

# SEC EDGAR API Configuration
SEC_USER_AGENT="VESPER Research vesper@research.com"
SEC_RATE_LIMIT=10.0
SEC_TIMEOUT=30
SEC_MAX_RETRIES=3

# S3/MinIO Storage Configuration
VESPER_S3_BUCKET=vesper-bronze
VESPER_S3_ENDPOINT=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1

# PostgreSQL Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_DB=vesper
POSTGRES_USER=vesper
POSTGRES_PASSWORD=vesper_password
