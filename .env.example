# =============================================================================
# VESPER Configuration Template
# =============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env files to version control

# =============================================================================
# Environment
# =============================================================================
ENVIRONMENT=development  # development, staging, production
DEBUG=true
LOG_LEVEL=INFO

# =============================================================================
# AWS Configuration
# =============================================================================
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=your-account-id
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# S3 Buckets
S3_BRONZE_BUCKET=vesper-bronze-dev
S3_SILVER_BUCKET=vesper-silver-dev
S3_GOLD_BUCKET=vesper-gold-dev
S3_ARTIFACTS_BUCKET=vesper-artifacts-dev

# EKS Cluster
EKS_CLUSTER_NAME=vesper-dev
KUBERNETES_NAMESPACE=vesper-dev

# =============================================================================
# Database Configuration
# =============================================================================
# PostgreSQL (with pgvector)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=vesper
POSTGRES_USER=vesper
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_MAX_CONNECTIONS=100

# Connection pool
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# =============================================================================
# Redis Configuration
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL_SECONDS=3600

# =============================================================================
# Kafka Configuration
# =============================================================================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_QUERIES=vesper.queries
KAFKA_TOPIC_ANSWERS=vesper.answers
KAFKA_TOPIC_EVENTS=vesper.events
KAFKA_CONSUMER_GROUP=vesper-consumers

# =============================================================================
# LLM Configuration
# =============================================================================
# Model Routing
PRIMARY_LLM_PROVIDER=openai  # openai, anthropic, local
FALLBACK_LLM_PROVIDER=local

# OpenAI
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.1

# Anthropic (optional)
ANTHROPIC_API_KEY=sk-ant-your-key
ANTHROPIC_MODEL=claude-3-opus-20240229

# Local Model Serving
LOCAL_MODEL_ENDPOINT=http://localhost:8000
LOCAL_MODEL_NAME=meta-llama/Llama-2-7b-chat-hf
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Model Router Configuration
MODEL_ROUTER_SIMPLE_THRESHOLD=0.3  # Complexity score below this uses simple model
MODEL_ROUTER_COST_WEIGHT=0.3       # Weight for cost in routing decision

# =============================================================================
# Retrieval Configuration
# =============================================================================
# Hybrid Search
RETRIEVAL_TOP_K=20
RETRIEVAL_RERANK_TOP_K=5
RETRIEVAL_BM25_WEIGHT=0.3
RETRIEVAL_VECTOR_WEIGHT=0.7

# Embeddings
EMBEDDING_DIMENSION=1536
EMBEDDING_BATCH_SIZE=32

# Chunking
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# =============================================================================
# Agent Configuration
# =============================================================================
AGENT_MAX_ITERATIONS=5
AGENT_TIMEOUT_SECONDS=60
AGENT_ENABLE_TOOLS=true

# LangGraph
LANGGRAPH_CHECKPOINTER=postgres

# =============================================================================
# Guardrails Configuration
# =============================================================================
GUARDRAILS_ENABLED=true
GUARDRAILS_JAILBREAK_DETECTION=true
GUARDRAILS_PII_REDACTION=true
GUARDRAILS_TOXICITY_THRESHOLD=0.8
GUARDRAILS_CITATION_REQUIRED=true

# NeMo Guardrails
NEMO_GUARDRAILS_CONFIG_PATH=./config/guardrails

# =============================================================================
# Monitoring Configuration
# =============================================================================
# Prometheus
PROMETHEUS_PORT=9090
METRICS_ENABLED=true

# Grafana
GRAFANA_PORT=3003
GRAFANA_ADMIN_PASSWORD=admin

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=vesper
TRACING_ENABLED=true
TRACING_SAMPLE_RATE=0.1

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=vesper-experiments

# LangSmith (optional)
LANGSMITH_API_KEY=your-langsmith-key
LANGSMITH_PROJECT=vesper

# =============================================================================
# API Gateway Configuration
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_TIMEOUT=300

# Authentication
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_ALLOW_CREDENTIALS=true

# =============================================================================
# Airflow Configuration
# =============================================================================
AIRFLOW_HOME=/opt/airflow
AIRFLOW__CORE__EXECUTOR=CeleryExecutor
AIRFLOW__CORE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@postgres/airflow
AIRFLOW__CELERY__RESULT_BACKEND=db+postgresql://airflow:airflow@postgres/airflow
AIRFLOW__CELERY__BROKER_URL=redis://redis:6379/0
AIRFLOW__CORE__FERNET_KEY=your-fernet-key
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=true
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__WEBSERVER__EXPOSE_CONFIG=true

# =============================================================================
# Frontend Configuration
# =============================================================================
# Analyst UI
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_APP_NAME=VESPER Analyst
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Ops UI
NEXT_PUBLIC_OPS_API_URL=http://localhost:8000
NEXT_PUBLIC_GRAFANA_URL=http://localhost:3003

# =============================================================================
# Data Ingestion
# =============================================================================
# SEC EDGAR
SEC_EDGAR_USER_AGENT=YourName your.email@example.com
SEC_EDGAR_API_RATE_LIMIT=10  # requests per second

# RSS Feeds
RSS_FEED_URLS=https://example.com/feed1.xml,https://example.com/feed2.xml
RSS_POLL_INTERVAL_MINUTES=60

# =============================================================================
# DVC Configuration
# =============================================================================
DVC_REMOTE=s3://vesper-dvc-dev
DVC_CACHE_DIR=.dvc/cache

# =============================================================================
# Feature Flags
# =============================================================================
FEATURE_STREAMING_ENABLED=true
FEATURE_CACHING_ENABLED=true
FEATURE_SELF_HEALING_ENABLED=false  # Enable in production after testing
FEATURE_AUTO_RETRAINING_ENABLED=false
FEATURE_SEMANTIC_CACHING=false

# =============================================================================
# Cost Management
# =============================================================================
MONTHLY_BUDGET_USD=1000
COST_ALERT_THRESHOLD_PERCENT=80
MAX_TOKENS_PER_REQUEST=8000

# =============================================================================
# Security
# =============================================================================
# Secrets
USE_AWS_SECRETS_MANAGER=false  # Set true in production
AWS_SECRETS_PREFIX=/vesper/

# Encryption
ENCRYPTION_KEY=your-encryption-key-change-in-production
ENCRYPT_DATA_AT_REST=true

# =============================================================================
# Development Tools
# =============================================================================
# Local Development
USE_LOCAL_SERVICES=true  # Use docker-compose services
MOCK_EXTERNAL_APIS=false

# Hot Reload
RELOAD=true  # Set false in production

# Testing
TEST_DATABASE_URL=postgresql://vesper:vesper@localhost:5432/vesper_test
