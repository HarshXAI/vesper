{
  "title": "Vesper Airflow SLAs",
  "tags": [
    "vesper",
    "airflow",
    "orchestration",
    "sla"
  ],
  "timezone": "browser",
  "panels": [
    {
      "title": "DAG Success Rate (%)",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "100 * sum(rate(airflow_dag_success_total[1h])) / sum(rate(airflow_dag_run_total[1h]))",
          "legendFormat": "Success Rate"
        }
      ],
      "options": {
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "area",
        "unit": "percent"
      }
    },
    {
      "title": "Active DAG Runs",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(airflow_dag_running)",
          "legendFormat": "Running"
        }
      ],
      "options": {
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "title": "Failed DAG Runs (Last 24h)",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(increase(airflow_dag_failed_total[24h]))",
          "legendFormat": "Failures"
        }
      ],
      "options": {
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "title": "Avg Task Duration (min)",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "expr": "avg(airflow_task_duration_seconds) / 60",
          "legendFormat": "Avg Duration"
        }
      ],
      "options": {
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "area",
        "unit": "m"
      }
    },
    {
      "title": "Task Duration by DAG (p95)",
      "type": "graph",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(airflow_task_duration_seconds_bucket[5m]))",
          "legendFormat": "{{dag_id}}"
        }
      ],
      "yaxes": [
        {
          "format": "s",
          "label": "Duration"
        },
        {
          "format": "short"
        }
      ]
    },
    {
      "title": "Task Success Rate by DAG",
      "type": "graph",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "targets": [
        {
          "expr": "100 * sum by (dag_id) (rate(airflow_task_success_total[5m])) / sum by (dag_id) (rate(airflow_task_run_total[5m]))",
          "legendFormat": "{{dag_id}}"
        }
      ],
      "yaxes": [
        {
          "format": "percent",
          "label": "Success %",
          "min": 0,
          "max": 100
        },
        {
          "format": "short"
        }
      ]
    },
    {
      "title": "DAG Run Frequency",
      "type": "graph",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "expr": "sum by (dag_id) (rate(airflow_dag_run_total[5m]))",
          "legendFormat": "{{dag_id}}"
        }
      ],
      "yaxes": [
        {
          "format": "short",
          "label": "Runs/sec"
        },
        {
          "format": "short"
        }
      ]
    },
    {
      "title": "Failed Tasks by DAG",
      "type": "graph",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "targets": [
        {
          "expr": "sum by (dag_id) (rate(airflow_task_failed_total[5m]))",
          "legendFormat": "{{dag_id}}"
        }
      ],
      "yaxes": [
        {
          "format": "short",
          "label": "Failures/sec"
        },
        {
          "format": "short"
        }
      ],
      "alert": {
        "conditions": [
          {
            "evaluator": {
              "params": [
                0.1
              ],
              "type": "gt"
            },
            "operator": {
              "type": "and"
            },
            "query": {
              "params": [
                "A",
                "5m",
                "now"
              ]
            },
            "reducer": {
              "params": [],
              "type": "avg"
            },
            "type": "query"
          }
        ],
        "executionErrorState": "alerting",
        "frequency": "60s",
        "handler": 1,
        "name": "High Task Failure Rate",
        "noDataState": "no_data",
        "notifications": []
      }
    },
    {
      "title": "Task Queue Depth",
      "type": "graph",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 22
      },
      "targets": [
        {
          "expr": "airflow_executor_queue_size",
          "legendFormat": "Queued Tasks"
        }
      ]
    },
    {
      "title": "Scheduler Heartbeat",
      "type": "graph",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 22
      },
      "targets": [
        {
          "expr": "airflow_scheduler_heartbeat",
          "legendFormat": "Scheduler Health"
        }
      ]
    },
    {
      "title": "Database Connections (Airflow)",
      "type": "graph",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 30
      },
      "targets": [
        {
          "expr": "pg_connections_active{application=\"airflow\"}",
          "legendFormat": "Active"
        },
        {
          "expr": "pg_connections_idle{application=\"airflow\"}",
          "legendFormat": "Idle"
        }
      ]
    },
    {
      "title": "Ingestion Pipeline Status",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 30
      },
      "targets": [
        {
          "expr": "sum by (dag_id, status) (airflow_dag_status)",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {},
            "renameByName": {
              "dag_id": "DAG",
              "status": "Status",
              "Value": "Count"
            }
          }
        }
      ]
    }
  ],
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "10s",
      "30s",
      "1m",
      "5m",
      "15m",
      "30m",
      "1h"
    ]
  }
}