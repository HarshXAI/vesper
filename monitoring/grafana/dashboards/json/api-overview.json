{
  "title": "Vesper API Overview",
  "tags": [
    "vesper",
    "api",
    "production"
  ],
  "timezone": "browser",
  "panels": [
    {
      "title": "Request Rate (req/s)",
      "type": "graph",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "rate(api_requests_total[5m])",
          "legendFormat": "{{route}} - {{status}}"
        }
      ]
    },
    {
      "title": "Active Requests",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(api_active_requests)",
          "legendFormat": "Active"
        }
      ]
    },
    {
      "title": "API Latency (p50, p95, p99)",
      "type": "graph",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(api_latency_seconds_bucket[5m]))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, rate(api_latency_seconds_bucket[5m]))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, rate(api_latency_seconds_bucket[5m]))",
          "legendFormat": "p99"
        }
      ],
      "yaxes": [
        {
          "format": "s",
          "label": "Latency"
        },
        {
          "format": "short"
        }
      ]
    },
    {
      "title": "Error Rate (%)",
      "type": "graph",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "100 * sum(rate(api_requests_total{status=~\"4xx|5xx\"}[5m])) / sum(rate(api_requests_total[5m]))",
          "legendFormat": "Error Rate"
        }
      ],
      "yaxes": [
        {
          "format": "percent",
          "label": "Error %"
        },
        {
          "format": "short"
        }
      ],
      "alert": {
        "conditions": [
          {
            "evaluator": {
              "params": [
                5
              ],
              "type": "gt"
            },
            "operator": {
              "type": "and"
            },
            "query": {
              "params": [
                "A",
                "5m",
                "now"
              ]
            },
            "reducer": {
              "params": [],
              "type": "avg"
            },
            "type": "query"
          }
        ],
        "executionErrorState": "alerting",
        "frequency": "60s",
        "handler": 1,
        "name": "High Error Rate",
        "noDataState": "no_data",
        "notifications": []
      }
    },
    {
      "title": "Requests by Status Code",
      "type": "piechart",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum by (status) (rate(api_requests_total[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "title": "Requests by Route",
      "type": "piechart",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum by (route) (rate(api_requests_total[5m]))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "title": "Stream Startup Latency (ms)",
      "type": "graph",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(stream_startup_latency_ms_bucket[5m]))",
          "legendFormat": "p95 startup"
        }
      ],
      "yaxes": [
        {
          "format": "ms",
          "label": "Latency"
        },
        {
          "format": "short"
        }
      ]
    },
    {
      "title": "Guardrails Blocks",
      "type": "graph",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "expr": "sum by (reason, stage) (rate(guardrails_block_total[5m]))",
          "legendFormat": "{{stage}}: {{reason}}"
        }
      ]
    },
    {
      "title": "Guardrails Latency (ms)",
      "type": "graph",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(guardrails_latency_ms_bucket{stage=\"pre\"}[5m]))",
          "legendFormat": "Pre-processing p95"
        },
        {
          "expr": "histogram_quantile(0.95, rate(guardrails_latency_ms_bucket{stage=\"post\"}[5m]))",
          "legendFormat": "Post-processing p95"
        }
      ],
      "yaxes": [
        {
          "format": "ms",
          "label": "Latency"
        },
        {
          "format": "short"
        }
      ]
    }
  ],
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m",
      "15m",
      "30m",
      "1h"
    ]
  }
}